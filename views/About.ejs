<script>
  const codeLines = [
    "// Fetching data from Express Backend\nfetch('/api/products')\n  .then(res => res.json())\n  .then(data => {\n    console.log('Status: Success ✅');\n    console.log('Developer: Mahnoor Asif');\n  });",
    
    "// Express Server Route Handling\napp.get('/about', (req, res) => {\n  res.render('About', {\n    status: 'Active',\n    stack: ['Node.js', 'Express', 'EJS']\n  });\n});",

    "// DummyJSON Mock Service Ready 🚀\nconst service = {\n  project: 'DummyJSON Clone',\n  purpose: 'Fast Frontend Prototyping',\n  architecture: 'MVC / Modular'\n};"
  ];

  let currentLineIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  const typingSpeed = 40;   
  const deletingSpeed = 20; 
  const delayBetween = 2000; 

  function typeEffect() {
    const currentText = codeLines[currentLineIndex];
    const codeElement = document.getElementById("typing-code");

    if (isDeleting) {
      codeElement.textContent = currentText.substring(0, charIndex - 1);
      charIndex--;
    } else {
      codeElement.textContent = currentText.substring(0, charIndex + 1);
      charIndex++;
    }

    let speed = isDeleting ? deletingSpeed : typingSpeed;

   
    if (!isDeleting && charIndex === currentText.length) {
      speed = delayBetween; 
      isDeleting = true;
    } 

    else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      currentLineIndex = (currentLineIndex + 1) % codeLines.length;
      speed = 500;
    }

    setTimeout(typeEffect, speed);
  }

 
  document.addEventListener("DOMContentLoaded", () => {
    typeEffect();
  });
</script>

